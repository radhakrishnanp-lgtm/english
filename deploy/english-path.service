[Unit]
Description=English Path learning website
After=network.target

[Service]
Type=simple
User=englishpath
WorkingDirectory=/opt/english-path
EnvironmentFile=/opt/english-path/.env
ExecStart=/usr/bin/node --experimental-sqlite --no-warnings=ExperimentalWarning server/index.js
Restart=always
RestartSec=3
# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/english-path
PrivateTmp=true

[Install]
WantedBy=multi-user.target
