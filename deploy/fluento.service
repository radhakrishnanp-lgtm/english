[Unit]
Description=Fluento learning website
After=network.target

[Service]
Type=simple
User=fluento
WorkingDirectory=/opt/fluento
EnvironmentFile=/opt/fluento/.env
ExecStart=/usr/bin/node --experimental-sqlite --no-warnings=ExperimentalWarning server/index.js
Restart=always
RestartSec=3
# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fluento
PrivateTmp=true

[Install]
WantedBy=multi-user.target
