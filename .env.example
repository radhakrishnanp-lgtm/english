# Copy to .env (or set these in the systemd unit) and adjust.

PORT=3000
HOST=127.0.0.1                 # keep 127.0.0.1 behind nginx; use 0.0.0.0 to expose directly
DATA_DIR=/var/lib/english-path # where the SQLite database (app.db) and secret.key live

# Long random string. Used to encrypt users' own AI keys in the database.
# If you leave it empty, a key is generated once into DATA_DIR/secret.key.
APP_SECRET=

# Set to true when the site is served over HTTPS.
SECURE_COOKIES=true

# Let new people create their own accounts (default: only admins create accounts).
# The first account created on a new server always becomes the admin.
ALLOW_REGISTRATION=false
# Optional: create/promote this admin at start-up.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- Default AI provider for everybody (any OpenAI-compatible API) ----
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-...
AI_MODEL=qwen/qwen3.8-omni-flash

# Let each user enter their own base URL / key / model in Settings.
ALLOW_USER_AI=true
# Use the client address that nginx (on this machine) adds to X-Forwarded-For.
TRUST_PROXY=true
# Abuse limits.
REGISTER_LIMIT=10
WRITE_LIMIT=300

# Allow user AI URLs that point to local/private addresses (e.g. Ollama on the same server).
ALLOW_PRIVATE_AI_URL=false
